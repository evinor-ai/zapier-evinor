{
  "name": "zapier-evinor",
  "version": "1.0.0",
  "description": "Evinor app for Zapier: start Zaps from verified Evinor sensor events and beat entries, find entities and file reports.",
  "license": "MIT",
  "private": true,
  "main": "index.js",
  "homepage": "https://evinor.ai",
  "author": {
    "name": "Evinor",
    "email": "hi@evinor.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evinor-ai/zapier-evinor.git"
  },
  "bugs": {
    "url": "https://github.com/evinor-ai/zapier-evinor/issues",
    "email": "hi@evinor.ai"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest --testTimeout 10000",
    "validate": "zapier-platform validate"
  },
  "dependencies": {
    "zapier-platform-core": "19.3.0"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nock": "14.0.17"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  }
}
